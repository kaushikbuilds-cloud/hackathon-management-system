{
  "appId": "app.hackathonbase.staff",
  "appName": "HackGround OS",
  "webDir": "www",
  "appendUserAgent": "HackathonBaseApp/1",
  "server": {
    "url": "https://hackgroundos.vercel.app",
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "launchAutoHide": true, "backgroundColor": "#0D0F1C", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false, "style": "LIGHT", "backgroundColor": "#F8FAFC" }
  }
}
