# -----------------------------------------------------------------------------
# Hackathon Management System — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# -----------------------------------------------------------------------------

# Supabase project (Settings → API Keys). New-style keys are preferred:
#   publishable key "sb_publishable_…" (public; RLS protects data)
#   secret key      "sb_secret_…"      (SERVER-ONLY; bypasses RLS)
# Legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Public base URL of this app. Used in QR codes on ID cards and in email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional settings
# Hours a staff invitation / password-reset link stays valid.
STAFF_INVITE_TTL_HOURS=72
# Hours a participant activation link stays valid.
PARTICIPANT_INVITE_TTL_HOURS=168
# Lifetime (seconds) of signed URLs for private PDFs and attachments.
SIGNED_URL_TTL_SECONDS=300
# One-time token enabling /setup to create the first Super Admin (16+ random chars).
# Remove it after setup.
# SETUP_TOKEN=

# Used only by `npm run seed:users` (local/dev). Leave blank to auto-generate passwords.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=

# Used only by the database integration tests (tests/db). A throwaway Postgres database.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/hms_test
